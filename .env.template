STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2
# Resend (primary notification provider)
RESEND_API_KEY=
RESEND_FROM=info@infinytree.com
STOREFRONT_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:8000
# Where sales reps sign in (sales commission plugin). Optional: defaults to STOREFRONT_PUBLIC_URL + /sales-portal
SALES_PORTAL_URL=
# Sales commission: the euro-forint rate is fetched from the ECB; set to false to enter rates by hand
SALES_COMMISSION_FX_FETCH=true
# Sales commission: the day of the month (1-28) the owner usually pays, shown to reps as the next payout
SALES_COMMISSION_PAYOUT_DAY=
# Sales commission: days an invite link works (default 14)
SALES_COMMISSION_INVITE_DAYS=
# Sales commission: what the application approval form starts with. The Level 2 percent (default 2)
# and the months it lasts (default 24, 0 = until the owner ends it). The owner can change both per approval
SALES_COMMISSION_LEVEL2_RATE=
SALES_COMMISSION_LEVEL2_MONTHS=
# Where "new sales application" emails go; defaults to CONTACT_EMAIL, then info@infinytree.com
SALES_COMMISSION_NOTIFY_EMAIL=
REVALIDATION_SECRET=supersecret

# SendGrid (optional fallback)
SENDGRID_API_KEY=
SENDGRID_FROM=

# Absolute path for uploaded media. Required in production.
# Example: /srv/medusa/uploads
# UPLOAD_DIR=
